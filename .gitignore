# ==========================================
# Root .gitignore untuk Project ms.Rent
# (Next.js Frontend & Golang Backend)
# ==========================================

# --- Operating System & Editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment Variables (Kredensial Sensitif) ---
# Abaikan file .env rahasia, kecualikan template .env.example
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# --- Frontend (Next.js / Node.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Backend (Golang) ---
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out
backend/tmp/

# --- Local Database Files (SQLite / Cache) ---
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/*.db-wal
